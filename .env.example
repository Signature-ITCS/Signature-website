# Public URL of the live site (used for canonical URLs, sitemap, Open Graph and JSON-LD).
NEXT_PUBLIC_SITE_URL=https://signature24hrs.com

# Sanity CMS (blog). Find these at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Sanity webhook that refreshes the blog instantly after publishing
SANITY_REVALIDATE_SECRET=

# Contact form email (SMTP). The password must only be set here/in Vercel, never committed.
SMTP_HOST=signature24hrs.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=smtp@signature24hrs.com
SMTP_PASS=
SMTP_FROM=Signature Website <smtp@signature24hrs.com>
CONTACT_TO=info@signature24hrs.com
# Optional: hidden copy of every enquiry to extra addresses (comma-separated)
CONTACT_BCC=
# Set to false to stop sending the automatic "we've received your enquiry" email
CONTACT_AUTOREPLY=true
